# ClickKnight Environment Configuration
# =====================================

# Server Configuration
NODE_ENV=development
PORT=5000

# Optional: Google Safe Browsing API
# Get your API key from: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=your_google_api_key_here
SAFE_BROWSING_KEY=your_google_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Optional: PhishTank API  
# Register at: https://www.phishtank.com/api_info.php
PHISHTANK_API_KEY=your_phishtank_key_here
PHISHTANK_KEY=your_phishtank_key_here

# Database Configuration (if using external database)
# DATABASE_URL=postgresql://user:password@localhost:5432/clickknight

# Session Configuration (for future user features)
SESSION_SECRET=your_secure_session_secret_here

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Security Configuration
CORS_ORIGIN=*
ALLOWED_ORIGINS=localhost:5000,127.0.0.1:5000

# Application Configuration
APP_NAME=ClickKnight
SCHOOL_NAME=SPS International School, Palwal
CONTACT_EMAIL=info@spspalwal.edu.in
CONTACT_PHONE=+91 98765 43210

# Feature Flags
ENABLE_WHOIS_CHECK=true
ENABLE_SECURITY_APIS=true
ENABLE_DEEP_SCAN=false
ENABLE_HISTORY_ENDPOINT=true

# Development Settings
LOG_LEVEL=info
DEBUG_MODE=false

# Notes:
# ------
# 1. Copy this file to .env and fill in your values
# 2. API keys are optional - the app works with heuristic analysis
# 3. Never commit your actual .env file to version control
# 4. For production, use proper secret management
